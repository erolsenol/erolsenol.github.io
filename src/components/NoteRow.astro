---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<li class="note-row">
  <div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
  </div>
  <a class="note-row__action" href={href}>Read note <span aria-hidden="true">↗</span></a>
</li>
