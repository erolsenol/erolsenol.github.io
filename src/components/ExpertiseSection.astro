---
import Icon from './Icon.astro';

const contributions = [
  {
    number: '01',
    icon: 'browser',
    title: 'Product interfaces',
    description: 'Clear navigation, considered states, and the small details that help people move through a product with confidence.',
    note: 'React · Vue · accessibility',
  },
  {
    number: '02',
    icon: 'brackets-angle',
    title: 'Frontend foundations',
    description: 'Typed contracts, reusable components, and design systems that keep new features easy to shape and maintain.',
    note: 'TypeScript · design systems',
  },
  {
    number: '03',
    icon: 'plugs-connected',
    title: 'Connected experiences',
    description: 'Thoughtful connections between interfaces, APIs, and providers, including the edge cases users should never have to think about.',
    note: 'APIs · integrations · product flows',
  },
] as const;
---

<section class="expertise-section site-width" id="expertise" aria-labelledby="expertise-title">
  <div class="expertise-section__intro">
    <p class="section-eyebrow">Where I can help</p>
    <h2 class="section-title" id="expertise-title">Good ideas,<br /><em>well made.</em></h2>
    <p class="expertise-section__summary">
      From the first interface to the system underneath it, I help turn product needs into clear, dependable frontend work.
    </p>
    <a class="text-link" href="/#contact">Talk about a project <Icon name="arrow-up-right" size={14} /></a>
  </div>
  <ol class="expertise-list">
    {contributions.map((item) => (
      <li class="expertise-item">
        <span class="expertise-item__number">{item.number}</span>
        <span class="expertise-item__icon"><Icon name={item.icon} size={20} /></span>
        <div class="expertise-item__copy">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
        <span class="expertise-item__note">{item.note}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .expertise-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(52px, 9vw, 128px);
    border-top: 1px solid var(--rule);
    padding-block: clamp(88px, 11vw, 148px);
  }

  .expertise-section__intro .section-title {
    font-size: clamp(58px, 7.7vw, 100px);
    line-height: 0.86;
  }

  .expertise-section__intro .section-title em {
    color: var(--accent);
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  .expertise-section__summary {
    max-width: 400px;
    margin: 27px 0 23px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .expertise-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .expertise-item {
    display: grid;
    grid-template-columns: 28px 38px minmax(0, 1fr);
    align-items: start;
    gap: 12px 16px;
    border-bottom: 1px solid var(--rule);
    padding-block: 25px 27px;
  }

  .expertise-item__number {
    padding-top: 3px;
    color: var(--accent-dark);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .expertise-item__icon {
    display: grid;
    width: 36px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--accent-dark);
  }

  .expertise-item__copy h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(25px, 2.5vw, 33px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .expertise-item__copy p {
    max-width: 520px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .expertise-item__note {
    grid-column: 3;
    color: var(--accent-dark);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .expertise-section {
      grid-template-columns: minmax(200px, 0.75fr) minmax(0, 1.25fr);
      gap: 38px;
    }

    .expertise-item {
      grid-template-columns: 20px 34px minmax(0, 1fr);
      gap: 10px;
    }
  }

  @media (max-width: 640px) {
    .expertise-section {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 78px 82px;
    }

    .expertise-section__intro .section-title {
      font-size: clamp(58px, 14vw, 82px);
    }

    .expertise-section__summary {
      max-width: 340px;
      margin-top: 18px;
      font-size: 13px;
    }

    .expertise-item {
      grid-template-columns: 18px 32px minmax(0, 1fr);
      gap: 9px;
      padding-block: 20px 22px;
    }

    .expertise-item__icon {
      width: 30px;
    }

    .expertise-item__copy h3 {
      font-size: 25px;
    }

    .expertise-item__copy p {
      font-size: 12px;
    }

    .expertise-item__note {
      font-size: 9px;
    }
  }
</style>
